  "lines": [
    {
      "file": "scene-0-line-0.mp3",
      "speaker": "小螞蟻",
      "text": "搬完種子，可以喝口水了。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-0-line-1.mp3",
      "speaker": "小螞蟻",
      "text": "哎呀，誰能幫幫我！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-1-line-0.mp3",
      "speaker": "白鴿",
      "text": "別怕，我看見你了！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-1-line-1.mp3",
      "speaker": "白鴿",
      "text": "抓住葉子，它會托住你。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-2-line-0.mp3",
      "speaker": "小螞蟻",
      "text": "我抓住了，謝謝你！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-2-line-1.mp3",
      "speaker": "白鴿",
      "text": "慢慢爬，岸邊就在前面。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-3-line-0.mp3",
      "speaker": "小螞蟻",
      "text": "白鴿還不知道有人靠近。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-3-line-1.mp3",
      "speaker": "小螞蟻",
      "text": "我要趕快提醒牠！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-4-line-0.mp3",
      "speaker": "捕鳥人",
      "text": "哎呀，什麼碰到我的腳？",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-4-line-1.mp3",
      "speaker": "白鴿",
      "text": "我看見了，趕快飛走！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-5-line-0.mp3",
      "speaker": "白鴿",
      "text": "你救了我，謝謝你的提醒。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-5-line-1.mp3",
      "speaker": "小螞蟻",
      "text": "朋友有困難，我也能幫忙。",
      "voice": "zh-TW-HsiaoChenNeural"
    }

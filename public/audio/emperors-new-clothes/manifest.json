  "lines": [
    {
      "file": "scene-0-line-0.mp3",
      "speaker": "騙子",
      "text": "這種布，笨的人看不見。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-0-line-1.mp3",
      "speaker": "皇帝",
      "text": "真稀奇，快替我做一套！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-1-line-0.mp3",
      "speaker": "大臣",
      "text": "我怎麼一點花紋也看不到？",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-1-line-1.mp3",
      "speaker": "騙子",
      "text": "您看，這條金色線多漂亮！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-2-line-0.mp3",
      "speaker": "皇帝",
      "text": "嗯，大家都說它很漂亮。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-2-line-1.mp3",
      "speaker": "大臣",
      "text": "這一定會是最特別的新衣。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-3-line-0.mp3",
      "speaker": "騙子",
      "text": "衣服很輕，幾乎感覺不到。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-3-line-1.mp3",
      "speaker": "皇帝",
      "text": "準備好了，就出發遊行。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-4-line-0.mp3",
      "speaker": "小孩",
      "text": "可是，他沒有穿那件新衣！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-4-line-1.mp3",
      "speaker": "大臣",
      "text": "原來，大家都和我看見一樣。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-5-line-0.mp3",
      "speaker": "小孩",
      "text": "說出看到的事，不是笨。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-5-line-1.mp3",
      "speaker": "皇帝",
      "text": "我應該早一點誠實面對。",
      "voice": "zh-TW-HsiaoChenNeural"
    }
  ]

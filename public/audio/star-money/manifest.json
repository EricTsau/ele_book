  "lines": [
    {
      "file": "scene-0-line-0.mp3",
      "speaker": "小女孩",
      "text": "您看起來很累，要休息嗎？",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-0-line-1.mp3",
      "speaker": "老人",
      "text": "我肚子好餓，走不動了。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-1-line-0.mp3",
      "speaker": "小女孩",
      "text": "這塊麵包，請您吃吧。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-1-line-1.mp3",
      "speaker": "老人",
      "text": "謝謝你，願你也得到照顧。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-2-line-0.mp3",
      "speaker": "小男孩",
      "text": "風好冷，我一直在發抖。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-2-line-1.mp3",
      "speaker": "小女孩",
      "text": "戴上帽子，去前面的村子。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-3-line-0.mp3",
      "speaker": "小妹妹",
      "text": "謝謝妳，我終於暖一點了。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-3-line-1.mp3",
      "speaker": "小女孩",
      "text": "我也希望找到安心的地方。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-4-line-0.mp3",
      "speaker": "小女孩",
      "text": "星星怎麼落到草地上了？",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-4-line-1.mp3",
      "speaker": "小女孩",
      "text": "我也有暖和的新衣服了！",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-5-line-0.mp3",
      "speaker": "小女孩",
      "text": "我有家了，也有熱熱的晚餐。",
      "voice": "zh-TW-HsiaoChenNeural"
    },
    {
      "file": "scene-5-line-1.mp3",
      "speaker": "小女孩",
